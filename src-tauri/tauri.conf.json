{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokioScope",
  "version": "0.1.0",
  "identifier": "dev.tokioscope.app",
  "build": {
    "beforeDevCommand": "cd frontend && bun run dev",
    "beforeBuildCommand": "cd frontend && bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TokioScope",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#2B2B2B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "See how Tokio schedules your async code, tick by tick.",
    "longDescription": "TokioScope visualizes deterministic tick-based Tokio scheduling for any pasted Rust async snippet, with timeline, worker pool, blocking pool, and source-line highlighting."
  }
}
